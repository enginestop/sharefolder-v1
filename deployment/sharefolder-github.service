[Unit]
Description=ShareFolder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sharefolder
Group=sharefolder
WorkingDirectory=/opt/sharefolder/state
ExecStart=/opt/sharefolder/current/sharefolder --env-file /opt/sharefolder/config/sharefolder.env serve
Environment=GOMAXPROCS=2
Environment=GOMEMLIMIT=768MiB
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sharefolder/state /opt/sharefolder/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
